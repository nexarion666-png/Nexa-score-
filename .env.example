# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# X / Twitter OAuth 2.0 — create an app in the X Developer Portal.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback
# Comma-separated scopes; offline.access enables refresh tokens where supported.
X_SCOPES=users.read,tweet.read,like.read,offline.access

# Optional Supabase persistence. App can run in preview mode without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
